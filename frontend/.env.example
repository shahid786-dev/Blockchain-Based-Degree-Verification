# Which deployment the frontend uses: "localhost" (default) or "sepolia".
# On Vercel this is set to "sepolia".
# VITE_NETWORK=localhost

# Optional overrides. Normally these come from
# src/contract/deployments/<network>.json (written by the deploy script).
# VITE_CONTRACT_ADDRESS=0x...
# VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# VITE_CHAIN_ID=11155111
